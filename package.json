{
  "name": "fgo-jct",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @fgo/desktop",
    "build": "npm run build --workspace @fgo/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "desktop:dev": "npm run tauri --workspace @fgo/desktop -- dev",
    "desktop:build": "npm run tauri --workspace @fgo/desktop -- build",
    "rust:test": "cargo test -p fgo-core -p fgo-adapters",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
